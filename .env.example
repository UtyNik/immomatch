# Шаблон конфигурации. Не заполняй его — скопируй в .env и правь копию:
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# Формат строки: ИМЯ_ПЕРЕМЕННОЙ=значение (без кавычек и пробелов вокруг "=").

# Токен бота, выдаётся @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Путь к файлу базы данных SQLite (относительно корня проекта).
# В Docker это /app/data/immomatch.db, каталог монтируется из ./data.
DB_PATH=data/immomatch.db

# Сколько раз один пользователь может обратиться к OpenAI за сутки.
# 0 — без ограничения (для тестов).
AI_DAILY_LIMIT=0

# Интервал фонового автопоиска в минутах
AUTO_SEARCH_INTERVAL_MINUTES=10

# Сколько пользователей автопоиск обрабатывает параллельно (1 = по очереди)
AUTO_SEARCH_CONCURRENCY=3
